---
interface Props {
  lang: 'it' | 'en';
}
const { lang } = Astro.props;
---

<section class="hero">
  <p class="eyebrow">Software Architect</p>
  {lang === 'it' ? (
    <h1>Software.<br />Architettura.<br /><span class="grad">Semplicità.</span></h1>
  ) : (
    <h1>Software.<br />Architecture.<br /><span class="grad">Simplicity.</span></h1>
  )}
  <p class="tagline">
    {lang === 'it'
      ? 'Progettare software significa togliere il superfluo. Riflessioni pratiche su linguaggi, ecosistemi e idee che resistono al tempo.'
      : 'Designing software means removing the superfluous. Practical reflections on languages, ecosystems, and ideas that stand the test of time.'}
  </p>
</section>

<style>
  .hero {
    padding: 5.5rem 0 4.5rem;
  }
  .eyebrow {
    margin: 0 0 1rem;
    font-size: 0.85rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--accent);
  }
  h1 {
    margin: 0;
    font-size: clamp(1.9rem, 7.5vw, 3.1rem);
    font-weight: 700;
    letter-spacing: -0.01em;
    line-height: 1.15;
  }
  /* caret da terminale dopo l'ultima parola del titolo */
  h1::after {
    content: '\2588';
    margin-left: 0.12em;
    color: var(--accent);
    animation: blink 1.15s step-end infinite;
  }
  @keyframes blink { 0%, 100% { opacity: 1; } 50% { opacity: 0; } }
  @media (prefers-reduced-motion: reduce) {
    h1::after { animation: none; opacity: 0.55; }
  }
  .grad {
    background: linear-gradient(90deg, var(--accent), var(--accent-2));
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
    color: transparent;
  }
  .tagline {
    margin: 1.75rem 0 0;
    max-width: 32rem;
    font-size: 1.05rem;
    line-height: 1.65;
    letter-spacing: 0;
    color: var(--muted);
  }
  @media (max-width: 600px) {
    .hero { padding: 3.25rem 0 2.75rem; }
    .tagline { font-size: 1.1rem; margin-top: 1.25rem; }
  }
</style>
